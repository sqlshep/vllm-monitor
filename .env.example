# Copy to .env and fill in. Used by both the agent (on the instance) and the
# dashboard (on your laptop). Generate a token with:  openssl rand -hex 32

# Shared secret between agent and dashboard (REQUIRED, same value on both sides).
AGENT_TOKEN=change-me-to-a-long-random-string

# ---- Dashboard only ----
# Where the agent is reachable (the instance's public IP + agent port).
AGENT_URL=http://YOUR_INSTANCE_PUBLIC_IP:9100
